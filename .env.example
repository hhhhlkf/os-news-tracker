# PostgreSQL 连接串，格式为 postgresql+psycopg://用户名:密码@主机:端口/数据库名，请替换占位凭据。
POSTGRES_DB=osnews
POSTGRES_USER=osnews_app
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://osnews_app:change-me@db:5432/osnews
# OpenAI 兼容的 LLM API 基础地址，通常以 /v1 结尾。
LLM_BASE_URL=https://your-llm-gateway.example.com/v1
# LLM API 鉴权密钥；必填敏感项，请勿提交真实值。
LLM_API_KEY=
# 调用的 LLM 模型名称，需与所接入网关支持的模型标识一致。
LLM_MODEL=your-model-name
# LLM 请求的最大并发数，填写正整数。
LLM_MAX_CONCURRENCY=4
# 搜索服务提供方；填写 internal 启用内部搜索，填写 none 禁用搜索。
SEARCH_PROVIDER=internal
# HTTP 抓取请求使用的 User-Agent 标识。
FETCH_USER_AGENT=os-news-tracker/0.1 (+internal)
# 对同一主机连续发起抓取请求的最小间隔，单位为秒，支持小数。
FETCH_PER_HOST_DELAY_SECONDS=2
# 是否运行微信公众号搜索实时集成任务；1 表示启用，0 表示禁用。
RUN_LIVE_WECHAT_SEARCH=0
# 微信公众号搜索实时任务使用的查询关键词。
WECHAT_SEARCH_QUERY=Linux
# 微信公众号搜索实时任务最多抓取的结果页数，填写正整数。
WECHAT_SEARCH_MAX_PAGES=5
# 微信公众号搜索流程模板；search_then_article_enrich 表示先搜索再抓取并补全文章正文。
WECHAT_SEARCH_TEMPLATE_VARIANT=search_then_article_enrich
# 微信公众号搜索结果是否继续抓取文章正文；1 表示抓取，0 表示仅保留搜索结果。
WECHAT_SEARCH_FETCH_CONTENT=1
# 是否运行微信公众号历史文章实时集成任务；1 表示启用，0 表示禁用。
RUN_LIVE_WECHAT_HISTORY=0
# 微信公众号历史文章实时任务使用的公众号名称。
WECHAT_HISTORY_ACCOUNT=示例公众号
# 微信公众号历史文章实时任务最多获取的文章数量，填写正整数。
WECHAT_HISTORY_LIMIT=5
# 微信公众号历史文章任务是否继续抓取正文；1 表示抓取，0 表示仅获取列表信息。
WECHAT_HISTORY_FETCH_CONTENT=0
# 微信公众平台登录 Cookie；敏感项，可留空并通过后台扫码续期写入运行时认证信息。
WECHAT_MP_COOKIE=
# 微信公众平台登录 Token；敏感项，可留空并通过后台扫码续期写入运行时认证信息。
WECHAT_MP_TOKEN=
# SMTP 服务器地址；使用 SMTP 邮件通道时填写。
SMTP_HOST=localhost
# SMTP 服务器端口；常见明文端口为 25，SSL 端口为 465。
SMTP_PORT=25
# SMTP 登录用户名；敏感项，不需要鉴权时可留空。
SMTP_USERNAME=
# SMTP 登录密码或授权码；敏感项，请勿提交真实值。
SMTP_PASSWORD=
# SMTP 发件人邮箱地址，需符合邮箱地址格式。
SMTP_FROM_EMAIL=no-reply@example.com
# SMTP 邮件显示的发件人名称。
SMTP_FROM_NAME=OS News Tracker
# 是否启用 SMTP STARTTLS；1 表示启用，0 表示禁用。
SMTP_USE_TLS=0
# 是否启用 SMTP 直连 SSL；1 表示启用，0 表示禁用，通常不要与 STARTTLS 同时开启。
SMTP_USE_SSL=0
# TOF4 平台应用标识；敏感项，使用 TOF4 邮件通道时填写。
TOF4_PAASID=
# TOF4 接口鉴权令牌；敏感项，请勿提交真实值。
TOF4_TOKEN=
# TOF4 HTTP API 地址；使用 TOF4 邮件通道时填写完整 URL。
TOF4_URL=
# TOF4 邮件的发件人邮箱地址，需符合邮箱地址格式。
TOF4_FROM_EMAIL=
# TOF4 邮件显示的发件人名称。
TOF4_FROM_NAME=OS News Tracker
# 系统管理入口访问密码；必填敏感项，部署时必须设置为强密码。
SYSTEM_ACCESS_PASSWORD=
# 审核并安装到宿主机的 gVisor 精确版本；必须与 `runsc --version` 完全一致。
DISCOVERY_SANDBOX_RUNSC_VERSION=release-YYYYMMDD.N
# 正式 connector Execute 的 gVisor 容器内存上限。
DISCOVERY_SANDBOX_MEMORY=512m
# OpenHands SDK Agent 的独立 gVisor 内存上限；不影响正式 connector Execute。
DISCOVERY_AGENT_SANDBOX_MEMORY=1g
# Chromium 与 Terminal 共存时的 Agent 专用 PID 上限；正式 connector 仍使用独立的较低限制。
DISCOVERY_AGENT_SANDBOX_PIDS_LIMIT=256
# crawler Runtime 的不可变镜像映射；正式执行禁止使用可变 tag 或运行时拉取。
DISCOVERY_SANDBOX_RUNTIME_IMAGES={"crawler-runtime:1":"registry.internal/os-news/crawler-runtime@sha256:<v1-64-hex-digest>","crawler-runtime:2":"registry.internal/os-news/crawler-runtime@sha256:<v2-64-hex-digest>","crawler-runtime:3":"registry.internal/os-news/crawler-runtime@sha256:<v3-64-hex-digest>"}
# 收件、建树后是否调用 LLM 整理并发布讨论条目。
DISCUSSION_AUTO_ORGANIZE=1
