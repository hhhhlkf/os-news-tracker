ARG BASE_IMAGE=localhost:5000/os-news/os-news-tracker-backend-base@sha256:09ec56aacc79149b36ea1e853ae3a65b475b986cdd11766b5d74f35623811ada
FROM ${BASE_IMAGE}

WORKDIR /app
# The base contains the audited Python, OS, Playwright, and application
# dependency layers from release 2fd9975.  Replace only application source.
RUN find /app -mindepth 1 -maxdepth 1 -exec rm -rf {} +
COPY . .

CMD ["uvicorn", "app.entry:app", "--host", "0.0.0.0", "--port", "8000"]
