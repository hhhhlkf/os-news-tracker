        <mxCell id="smart_module" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECFEFF;strokeColor=#06B6D4;strokeWidth=2;fontColor=#0F172A;fontSize=18;fontStyle=1;shadow=1;align=left;spacingLeft=16;spacingTop=12;" value="智能探查模块&lt;br/&gt;&lt;font style=&quot;font-size:14px;&quot;&gt;作用：为一个新站点自动探出“怎么抓”&lt;br/&gt;输入：站点 URL + 可选名称（支持自动命名）&lt;br/&gt;输出：一个可复用的 Crawl Method（抓取模板）&lt;/font&gt;" vertex="1">
          <mxGeometry height="140" width="650" x="110" y="170" as="geometry" />
        </mxCell>
        <mxCell id="fetch_module" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#22C55E;strokeWidth=2;fontColor=#0F172A;fontSize=18;fontStyle=1;shadow=1;align=left;spacingLeft=16;spacingTop=12;" value="抓取模块 · 爬取方式库&lt;br/&gt;&lt;font style=&quot;font-size:14px;&quot;&gt;作用：复用已生成的抓取模板，稳定批量抓取&lt;br/&gt;输入：已保存的 Crawl Method / DSL Recipe&lt;br/&gt;输出：原始条目 -&gt; 新闻处理流水线 -&gt; 新闻流&lt;/font&gt;" vertex="1">
          <mxGeometry height="140" width="650" x="1040" y="170" as="geometry" />
